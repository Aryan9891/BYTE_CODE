# ==============================================================================
# SAHAYAK (S-12) ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Notice: Copy this file to .env.local for local development.
# NEVER commit real credentials, database passwords, or cryptographic keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Sahayak"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en" # Options: en, hi, bn

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Primary connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/sahayak_db?schema=public&sslmode=prefer"
# Direct connection for migrations (required if using transaction pooling like PgBouncer)
DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/sahayak_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION MANAGEMENT (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate_a_secure_32_byte_random_string_for_auth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHY, PSEUDONYMIZATION & PRIVACY ENCLAVE
# ------------------------------------------------------------------------------
# Institutional salt for HMAC-SHA256 pseudonym generation (Separates identity from telemetry)
# Generate with: openssl rand -hex 32
PSEUDO_SALT_SECRET="generate_a_secure_hex_32_salt_for_pseudonym_generation"

# Master key for field-level encryption of private journals and sensitive survey text (AES-256-GCM)
# Must be exactly 32 bytes (64 hex characters)
# Generate with: openssl rand -hex 32
APP_MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 5. PRIVACY & K-ANONYMITY PARAMETERS
# ------------------------------------------------------------------------------
# Minimum cohort size for aggregate institutional metrics (Default: 10)
# Any query yielding fewer than this number of students is suppressed.
K_ANONYMITY_MIN_COHORT_SIZE=10

# Data retention limits (in days)
SURVEY_RETENTION_DAYS=90
ACADEMIC_SIGNALS_RETENTION_DAYS=60
HELP_SEEKING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# 6. RISK ENGINE & MINIMIZATION PARAMETERS
# ------------------------------------------------------------------------------
# Hysteresis and cooldown window in days
ALERT_COOLDOWN_DAYS=7
# Decay parameter for EWMA calculation (0.1 to 0.5)
EWMA_ALPHA=0.35
# Z-score thresholds
TIER_1_Z_THRESHOLD=1.5
TIER_2_Z_THRESHOLD=2.0
TIER_3_Z_THRESHOLD=3.0

# ------------------------------------------------------------------------------
# 7. CRISIS & SUPPORT DIRECTORY CONFIGURATION
# ------------------------------------------------------------------------------
# Active region code for support resources (e.g., IN, US, UK, GLOBAL)
DEFAULT_REGION_CODE="IN"

# Default emergency telephone numbers (VERIFY BEFORE LAUNCH in production)
NEXT_PUBLIC_NATIONAL_CRISIS_PHONE="14416" # Tele-MANAS (India)
NEXT_PUBLIC_CAMPUS_EMERGENCY_PHONE="112" # Universal Emergency (India)

# Automated Emergency Auto-Contact: STRICTLY OFF by default per ethics policy
# Setting to true requires documented institutional legal authorization
ENABLE_AUTOMATED_EMERGENCY_DISPATCH="false"

# ------------------------------------------------------------------------------
# 8. RATE LIMITING (In-Memory or Upstash Redis for serverless)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_REQUESTS_PER_MINUTE=60

