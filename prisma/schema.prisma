// Prisma schema for Sahayak (S-12: AI-Based Mental Health Support and Crisis Detection)
// Architecture Reference: docs/DATA_MODEL.md & docs/ARCHITECTURE.md
// Multi-Schema Partitioning: identity, telemetry, audit

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "telemetry", "audit"]
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  COUNSELOR
  ADMIN
  SUPER_ADMIN

  @@schema("identity")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("identity")
}

enum ConsentToggleName {
  consent_surveys
  consent_academic
  consent_help_seeking
  consent_counselor_triage
  consent_journal_signals
  emergency_escalation_acknowledged

  @@schema("identity")
}

enum ConsentAction {
  GRANTED
  REVOKED

  @@schema("identity")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("telemetry")
}

enum HelpSeekingSignalType {
  BOOKING_ABANDONED
  RESOURCE_VIEW
  NOCTURNAL_USAGE

  @@schema("telemetry")
}

enum RiskTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3

  @@schema("telemetry")
}

enum CaseStatus {
  OPEN
  REVIEWED
  OUTREACH_SENT
  CLOSED

  @@schema("telemetry")
}

enum FeedbackRating {
  APPROPRIATE_TIMELY
  TOO_SENSITIVE
  FALSE_ALARM_NOISE

  @@schema("telemetry")
}

enum SupportCategory {
  CAMPUS_COUNSELING
  NATIONAL_HELPLINE
  EMERGENCY_SERVICES
  PEER_SUPPORT
  SPECIALIZED

  @@schema("audit")
}

enum VerificationStatus {
  VERIFIED
  NEEDS_REVERIFICATION
  PENDING_INITIAL_CHECK

  @@schema("audit")
}

// -----------------------------------------------------------------------------
// 1. IDENTITY REALM (schema: "identity")
// Holds real-world identities, credentials, envelope encryption keys, and consent.
// -----------------------------------------------------------------------------

model Institution {
  id                      String   @id @default(uuid())
  name                    String
  slug                    String   @unique
  domain_allowlist        String[]
  emergency_auto_dispatch Boolean  @default(false)
  data_retention_days     Int      @default(365)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  users User[]

  @@map("institutions")
  @@schema("identity")
}

model User {
  id                 String     @id @default(uuid())
  institution_id     String
  email_encrypted    String
  email_lookup_hash  String     @unique // Keyed HMAC lookup hash (NO plain email column)
  password_hash      String
  full_name          String
  role               Role       @default(STUDENT)
  status             UserStatus @default(ACTIVE)
  adult_confirmed    Boolean    @default(false) // 18+ adult self-declaration
  department         String?
  cohort_year        String? // Coarse cohort identifier (e.g. "2026")
  is_synthetic       Boolean    @default(false)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  institution     Institution      @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  student_profile StudentProfile?
  student_key     StudentKey?
  consent_records ConsentRecord[]
  assigned_cases  CounselorCase[]  @relation("CounselorAssignedCases")

  @@index([institution_id])
  @@index([role])
  @@map("users")
  @@schema("identity")
}

model StudentKey {
  id            String   @id @default(uuid())
  user_id       String   @unique
  encrypted_dek String
  dek_iv        String
  dek_auth_tag  String
  kek_salt      String
  key_version   Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("student_keys")
  @@schema("identity")
}

model ConsentRecord {
  id                   String            @id @default(uuid())
  student_pseudo_id    String
  user_id              String
  toggle               ConsentToggleName
  action               ConsentAction
  consent_text_version String            @default("1.0.0")
  locale               String            @default("en")
  created_at           DateTime          @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([student_pseudo_id])
  @@index([user_id])
  @@map("consent_records")
  @@schema("identity")
}

model ConsentState {
  id                                String   @id @default(uuid())
  student_pseudo_id                 String   @unique
  consent_surveys                   Boolean  @default(false)
  consent_academic                  Boolean  @default(false)
  consent_help_seeking              Boolean  @default(false)
  consent_counselor_triage          Boolean  @default(false)
  consent_journal_signals           Boolean  @default(false)
  emergency_escalation_acknowledged Boolean  @default(false)
  last_updated_at                   DateTime @default(now())

  @@index([student_pseudo_id])
  @@map("consent_states")
  @@schema("identity")
}

// -----------------------------------------------------------------------------
// 2. TELEMETRY REALM (schema: "telemetry")
// Keyed solely by student_pseudo_id. Zero foreign keys or joins to plain identities.
// -----------------------------------------------------------------------------

model StudentProfile {
  student_pseudo_id String   @id
  user_id           String   @unique
  department        String
  cohort_year       String
  locale            String   @default("en")
  key_version       Int      @default(1)
  is_synthetic      Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user                 User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  survey_responses     SurveyResponse[]
  academic_signals     AcademicSignal[]
  help_seeking_signals HelpSeekingSignal[]
  risk_evaluations     RiskEvaluation[]
  journal_entries      JournalEntry[]
  counselor_cases      CounselorCase[]
  deletion_jobs        RevocationDeletionJob[]

  @@index([department, cohort_year])
  @@map("student_profiles")
  @@schema("telemetry")
}

model RevocationDeletionJob {
  id                   String            @id @default(uuid())
  student_pseudo_id    String
  toggle               ConsentToggleName
  status               JobStatus         @default(PENDING)
  scheduled_at         DateTime          @default(now())
  completed_at         DateTime?
  records_purged_count Int               @default(0)
  details              Json?

  student_profile StudentProfile @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)

  @@index([student_pseudo_id, status])
  @@map("revocation_deletion_jobs")
  @@schema("telemetry")
}

model SurveyResponse {
  id                String   @id @default(uuid())
  student_pseudo_id String
  instrument_type   String
  answers           Json
  normalized_score  Float
  acute_flag_raised Boolean  @default(false)
  submitted_at      DateTime @default(now())

  student_profile StudentProfile @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)

  @@index([student_pseudo_id, submitted_at])
  @@map("survey_responses")
  @@schema("telemetry")
}

model AcademicSignal {
  id                       String   @id @default(uuid())
  student_pseudo_id        String
  submission_delay_hours   Float
  attendance_percentage    Float
  active_assignments_count Int
  recorded_at              DateTime @default(now())

  student_profile StudentProfile @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)

  @@index([student_pseudo_id, recorded_at])
  @@map("academic_signals")
  @@schema("telemetry")
}

model HelpSeekingSignal {
  id                String                @id @default(uuid())
  student_pseudo_id String
  signal_type       HelpSeekingSignalType
  metadata          Json
  recorded_at       DateTime              @default(now())

  student_profile StudentProfile @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)

  @@index([student_pseudo_id, recorded_at])
  @@map("help_seeking_signals")
  @@schema("telemetry")
}

model RiskEvaluation {
  id                     String   @id @default(uuid())
  student_pseudo_id      String
  tier                   RiskTier
  confidence_score       Float
  corroboration_details  Json
  plain_language_reasons Json
  evaluated_at           DateTime @default(now())

  student_profile StudentProfile  @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)
  counselor_cases CounselorCase[]

  @@index([student_pseudo_id, evaluated_at])
  @@index([tier])
  @@map("risk_evaluations")
  @@schema("telemetry")
}

model JournalEntry {
  id                String   @id @default(uuid())
  student_pseudo_id String
  title_encrypted   String
  content_encrypted String
  iv                String
  auth_tag          String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  student_profile StudentProfile @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)

  @@index([student_pseudo_id])
  @@map("journal_entries")
  @@schema("telemetry")
}

model CounselorCase {
  id                    String     @id @default(uuid())
  risk_evaluation_id    String
  student_pseudo_id     String
  status                CaseStatus @default(OPEN)
  assigned_counselor_id String?
  opened_at             DateTime   @default(now())
  closed_at             DateTime?

  risk_evaluation    RiskEvaluation  @relation(fields: [risk_evaluation_id], references: [id], onDelete: Cascade)
  student_profile    StudentProfile  @relation(fields: [student_pseudo_id], references: [student_pseudo_id], onDelete: Cascade)
  assigned_counselor User?           @relation("CounselorAssignedCases", fields: [assigned_counselor_id], references: [id], onDelete: SetNull)
  feedback           CaseFeedback?

  @@index([status])
  @@index([student_pseudo_id])
  @@map("counselor_cases")
  @@schema("telemetry")
}

model CaseFeedback {
  id                String         @id @default(uuid())
  counselor_case_id String         @unique
  feedback_rating   FeedbackRating
  notes             String?
  submitted_at      DateTime       @default(now())

  counselor_case CounselorCase @relation(fields: [counselor_case_id], references: [id], onDelete: Cascade)

  @@map("case_feedbacks")
  @@schema("telemetry")
}

// -----------------------------------------------------------------------------
// 3. AUDIT REALM (schema: "audit")
// Cryptographically chained, immutable audit ledger & verified directory.
// -----------------------------------------------------------------------------

model AuditLogEntry {
  id                  String   @id @default(uuid())
  sequence_number     BigInt   @default(autoincrement())
  timestamp           DateTime @default(now())
  actor_pseudo_id     String   // Audit pseudonym (HMAC), NOT user ID or email!
  actor_role          Role
  action_type         String
  resource_type       String
  target_pseudo_id    String?
  details             Json     // Allowlisted enums, counters, metadata (NO PII, NO content)
  previous_entry_hash String
  current_hash        String

  @@index([timestamp])
  @@index([actor_pseudo_id])
  @@index([target_pseudo_id])
  @@index([sequence_number])
  @@map("audit_log_entries")
  @@schema("audit")
}

model VerifiedSupportResource {
  id                    String             @id @default(uuid())
  institution_id        String?
  name                  String
  category              SupportCategory
  description           String
  phone                 String
  sms_or_whatsapp       String?
  web_url               String
  source_url            String
  operating_hours       String
  languages_supported   String[]
  region_code           String
  is_free_toll_free     Boolean            @default(true)
  is_crisis_priority    Boolean            @default(false)
  verification_status   VerificationStatus @default(VERIFIED)
  verified_by           String
  verified_on           DateTime
  next_verification_due DateTime
  verification_notes    String?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  @@index([region_code])
  @@index([category])
  @@map("verified_support_resources")
  @@schema("audit")
}
